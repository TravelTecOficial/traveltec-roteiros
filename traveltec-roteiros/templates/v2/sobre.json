  "custom_css": ".rt-barra{width:70px;height:4px;background:#E98300;margin:22px 0 26px}\n.rt-barra-c{margin:22px auto 48px}\n@media (min-width:1025px){.rt-sb-hist{padding-left:max(20px,calc((100vw - 1140px) / 2))!important}}\n.rt-sb-hist .elementor-widget-text-editor p{margin:0 0 14px}\n.rt-sb-fxp p{max-width:52ch;font-size:18px;margin:0}\n.rt-razoes{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;width:100%}\n@media (max-width:1024px){.rt-razoes{grid-template-columns:repeat(2,1fr)}}\n@media (max-width:600px){.rt-razoes{grid-template-columns:1fr}}\n.rt-razoes article{position:relative;aspect-ratio:3/4;background-size:cover;background-position:center;overflow:hidden;border-radius:4px}\n.rt-razoes article::before{content:\"\";position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.82) 0%,rgba(0,0,0,.25) 55%,rgba(0,0,0,0) 100%);transition:background .45s}\n.rt-razoes article>div{position:absolute;left:0;right:0;bottom:0;padding:26px 24px;color:#fff;transform:translateY(calc(100% - 78px));transition:transform .5s cubic-bezier(.22,.61,.36,1)}\n.rt-razoes h3{font-family:Montserrat,sans-serif;font-size:21px;font-weight:600;color:#fff;margin:0 0 12px;padding-top:14px;border-top:3px solid #E98300;display:inline-block}\n.rt-razoes p{font-size:15px;line-height:1.55;color:rgba(255,255,255,.9);margin:0;opacity:0;transition:opacity .4s .1s}\n.rt-razoes article:hover>div{transform:none}\n.rt-razoes article:hover p{opacity:1}\n.rt-razoes article:hover::before{background:linear-gradient(to top,rgba(0,0,0,.88) 0%,rgba(0,0,0,.55) 60%,rgba(0,0,0,.2) 100%)}\n@media (hover:none){.rt-razoes article>div{transform:none}.rt-razoes p{opacity:1}}\n.rt-hero{box-shadow:inset 0 170px 120px -80px rgba(0,0,0,.45)}\n.elementor-widget-html:has(.rt-razoes),.elementor-element-sbrg{width:100%;align-self:stretch}",
  "hide_title": "yes"
 }
