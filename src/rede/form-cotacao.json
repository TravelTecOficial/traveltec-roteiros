 semana\"},{\"__visible\":true,\"label\":\"2 semanas\",\"value\":\"2 semanas\"},{\"__visible\":true,\"label\":\"3 semanas\",\"value\":\"3 semanas\"},{\"__visible\":true,\"label\":\"Mais de 3 semanas\",\"value\":\"Mais de 3 semanas\"}],\"label\":\"Duração da Viagem \",\"name\":\"duracao_da_viagem\",\"desc\":\"Tempo deseja ficar em viagem\",\"default\":\"Selecione\",\"required\":true,\"className\":\" jet-sm-gb-wrapper jet-sm-gb-c6ef79be-d2bc-47c3-94a3-36f64eb31ce0\"} /--></div>\n<!-- /wp:column --></div>\n<!-- /wp:columns -->\n<!-- /wp:jet-forms/conditional-block -->\n\n<!-- wp:heading {\"level\":4,\"style\":{\"typography\":{\"fontSize\":\"18px\"}}} -->\n<h4 class=\"wp-block-heading\" style=\"font-size:18px\"><strong>Passageiros</strong></h4>\n<!-- /wp:heading -->\n\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:jet-forms/select-field {\"field_options\":[{\"__visible\":true,\"label\":\"01\",\"value\":\"1\"},{\"__visible\":true,\"label\":\"02\",\"value\":\"2\"},{\"__visible\":true,\"label\":\"03\",\"value\":\"3\"},{\"__visible\":true,\"label\":\"04\",\"value\":\"4\"},{\"__visible\":true,\"label\":\"+ de 4\",\"value\":\"+ de 4\"}],\"label\":\"Adultos \",\"name\":\"qtde_de_adultos\",\"desc\":\"Qtde de adultos\",\"required\":true,\"className\":\" jet-sm-gb-wrapper jet-sm-gb-f307d00d-3005-4e7b-8977-11b39e0b417f\"} /--></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:jet-forms/select-field {\"field_options\":[{\"__visible\":true,\"label\":\"00\",\"value\":\"0\"},{\"__visible\":true,\"label\":\"01\",\"value\":\"1\"},{\"__visible\":true,\"label\":\"02\",\"value\":\"2\"},{\"__visible\":true,\"label\":\"03\",\"value\":\"3\"},{\"__visible\":true,\"label\":\"04\",\"value\":\"4\"},{\"__visible\":true,\"label\":\"+ de 4\",\"value\":\"+ de 4\"}],\"label\":\"Crianças\",\"name\":\"qtde_de_criancas\",\"desc\":\"Entre 02 e 12 anos\",\"className\":\" jet-sm-gb-wrapper jet-sm-gb-91c3