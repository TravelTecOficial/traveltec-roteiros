 "content": "<!-- wp:jet-forms/hidden-field {\"return_raw\":true,\"field_value\":\"post_title\",\"name\":\"post_title\"} /-->\n\n<!-- wp:heading -->\n<h2 class=\"wp-block-heading\">Destino da Viagem</h2>\n<!-- /wp:heading -->\n\n<!-- wp:jet-forms/text-field {\"label\":\"Informe o destino que deseja viajar\",\"name\":\"field_destino\"} /-->\n\n<!-- wp:paragraph -->\n<p></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:heading {\"level\":4,\"style\":{\"typography\":{\"fontSize\":\"18px\"}}} -->\n<h4 class=\"wp-block-heading\" style=\"font-size:18px\"><strong>Datas da viagem</strong></h4>\n<!-- /wp:heading -->\n\n<!-- wp:jet-forms/radio-field {\"field_options\":[{\"__visible\":true,\"label\":\"Eu sei a data da minha viagem\",\"value\":\"1\"},{\"__visible\":true,\"label\":\"Eu tenho datas aproximadas\",\"value\":\"2\"}],\"label\":\"Informe a data de sua viagem\",\"name\":\"field_periodo\",\"desc\":\"Selecione a data ou período da sua viagem\",\"default\":\"1\",\"required\":true,\"className\":\" jet-sm-gb-wrapper jet-sm-gb-1d799617-8dff-4dac-b6a8-b721998c11ba\"} /-->\n\n<!-- wp:jet-forms/conditional-block {\"name\":\"8ae8353d-16be-4bec-97b2-62a491447197\",\"func_type\":\"show\",\"conditions\":[{\"__visible\":true,\"field\":\"field_periodo\",\"operator\":\"equal\",\"value\":\"1\"}],\"className\":\" jet-sm-gb-wrapper jet-sm-gb-9aae3469-f2fb-48fe-a562-cc30de929bd5\"} -->\n<!-- wp:columns -->\n<div class=\"wp-block-columns\"><!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:jet-forms/date-field {\"label\":\"data de embarque \",\"name\":\"data_de_embarque\",\"desc\":\"Data de inicio da viagem\",\"required\":true,\"className\":\" jet-sm-gb-wrapper jet-sm-gb-ad172724-e668-4aae-8c6e-e0669491da60\"} /--></div>\n<!-- /wp:column -->\n\n<!-- wp:column -->\n<div class=\"wp-block-column\"><!-- wp:jet-forms/date-field {\"label\":\"data de retorno \",\"name\":\"data_de_retorno\",\"desc\":\"Data de término da viagem\",\"required\":true,\"className\":\" jet-sm-gb-wrapper jet-sm-gb-8e01609c